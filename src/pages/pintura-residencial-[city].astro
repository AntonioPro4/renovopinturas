---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cities, getCityBySlug, getNearbyCities } from '../data/cities';
import { company } from '../data/company';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;

const nearbyCities = getNearbyCities(city.slug);

const metaDescription = `Pintura residencial em ${city.name} com qualidade profissional. Orçamento gratuito, garantia de 5 anos. Profissionais experientes na região.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: `${company.name} - ${city.name}`,
  description: metaDescription,
  url: `${company.site}/pintura-residencial-${city.slug}`,
  telephone: `+55 ${company.whatsapp}`,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: city.name,
    addressRegion: company.addressRegion,
    addressCountry: company.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.latitude,
    longitude: company.longitude,
  },
  priceRange: company.priceRange,
  areaServed: {
    '@type': 'City',
    name: city.name,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '08:00',
    closes: '20:00',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: company.site },
    { '@type': 'ListItem', position: 2, name: 'Pintura Residencial', item: `${company.site}/pintura-residencial` },
    { '@type': 'ListItem', position: 3, name: city.name, item: `${company.site}/pintura-residencial-${city.slug}` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Quanto custa o m² de pintura em ${city.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `O valor médio é de R$ ${city.pricing.residencial}/m² para pintura residencial e R$ ${city.pricing.comercial}/m² para pintura comercial. O orçamento é gratuito e personalizado.`,
      },
    },
    {
      '@type': 'Question',
      name: `Vocês atendem ${city.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Sim! Atendemos ${city.name} e região com equipes especializadas. Solicite seu orçamento gratuito pelo WhatsApp.`,
      },
    },
    {
      '@type': 'Question',
      name: `Qual é a garantia oferecida?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Oferecemos garantia de 5 anos para todos os nossos serviços de pintura, cobrindo mão de obra e materiales utilizados.',
      },
    },
  ],
};

const combinedSchema = [schema, breadcrumbSchema, faqSchema];

const pageTitle = `Pintura Residencial em ${city.name}`;
const whatsappMessage = `Olá! Gostaria de um orçamento gratuito para pintura em ${city.name}.`;
const ctaWhatsappUrl = `${company.whatsappUrl}?text=${encodeURIComponent(whatsappMessage)}`;

const services = [
  {
    icon: `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
    title: 'Pintura Residencial',
    desc: `Apartamentos e casas em ${city.name}. Reboco, massa corrida e pintura com acabamento impecável.`,
    price: `R$ ${city.pricing.residencial}/m²`,
    color: city.gradient,
  },
  {
    icon: `<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
    title: 'Pintura Comercial',
    desc: `Escritórios, lojas e galpões comerciais em ${city.name}. Trabalho com cronograma flexível.`,
    price: `R$ ${city.pricing.comercial}/m²`,
    color: '#F57C00',
  },
  {
    icon: `<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>`,
    title: 'Impermeabilização',
    desc: `Proteção contra infiltrações em lajes e paredes em ${city.name}. Solução duradoura e garantia estendida.`,
    price: `R$ ${city.pricing.impermeabilizacao}/m²`,
    color: '#00695C',
  },
];

const faqs = [
  {
    q: `Qual o valor do m² de pintura em ${city.name}?`,
    a: `O preço médio para pintura residencial em ${city.name} é de R$ ${city.pricing.residencial}/m². Para pintura comercial, o valor é R$ ${city.pricing.comercial}/m². O orçamento é sempre gratuito e personalizado de acordo com a sua necessidade.`,
  },
  {
    q: 'Vocês atendem minha região?',
    a: `Sim! Atendemos ${city.name} e toda a região com equipes de profissionais experientes. Entre em contato pelo WhatsApp para verificar a disponibilidade na sua rua ou bairro.`,
  },
  {
    q: 'Que tipos de pintura vocês fazem?',
    a: 'Fazemos pintura interna (paredes, tetos, portas, janelas), pintura externa (fachadas), reboco, massa corrida, textura, grafiato e impermeabilização. Trabalho completo do início ao fim.',
  },
  {
    q: 'Qual é a garantia?',
    a: 'Oferecemos garantia de 5 anos para todos os serviços de pintura, cobrindo tanto mão de obra quanto materiais utilizados. Sua tranquilidade é nossa prioridade.',
  },
  {
    q: 'Como funciona o orçamento gratuito?',
    a: 'Basta enviar uma mensagem pelo WhatsApp. Nossa equipe vai até o local para avaliar, tirar medidas e apresentar um orçamento detalhado, sem compromisso. Resposta rápida garantida.',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  canonical={`/pintura-residencial-${city.slug}/`}
  city={city.name}
  citySlug={city.slug}
  breadcrumbItems={[
    { name: 'Pintura Residencial', href: '/pintura-residencial' },
    { name: city.name, href: `/pintura-residencial-${city.slug}` },
  ]}
  schema={combinedSchema}
>
  <!-- Hero -->
  <section
    class="relative overflow-hidden"
    style={`background: linear-gradient(135deg, ${city.gradient} 0%, ${city.gradientEnd} 100%);`}
  >
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100" height="100" fill="url(#grid)"/>
      </svg>
    </div>

    <div class="container py-16 md:py-20 relative">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-white/10 text-white text-xs font-semibold px-4 py-1.5 rounded-full mb-4">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
          </svg>
          {city.region}
        </span>
        <h1 class="text-white font-extrabold text-3xl md:text-4xl lg:text-5xl mb-4 leading-tight">
          Pintura Residencial em {city.name}
        </h1>
        <p class="text-white/80 text-base md:text-lg mb-8 max-w-2xl leading-relaxed">
          Especialistas em pintura residencial e comercial em {city.name}. Orçamento gratuito, garantia de 5 anos e profissionais experientes na sua região.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={ctaWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#25D366] hover:bg-[#20BA5C] text-white font-semibold px-8 py-4 rounded-xl text-center transition-all hover:scale-105 flex items-center justify-center gap-3 text-lg"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Orçamento Grátis em {city.name}
          </a>
          <a
            href="#bairros"
            class="bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-4 rounded-xl text-center transition-all flex items-center justify-center gap-2"
          >
            Ver Bairros
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-white border-b border-gray-200">
    <div class="container py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-2xl font-extrabold" style={`color: ${city.gradient};`}>+500</div>
          <div class="text-sm text-gray-500 mt-1">Clientes Atendidos</div>
        </div>
        <div>
          <div class="text-2xl font-extrabold" style={`color: ${city.gradient};`}>+10</div>
          <div class="text-sm text-gray-500 mt-1">Anos de Experiência</div>
        </div>
        <div>
          <div class="text-2xl font-extrabold" style={`color: ${city.gradient};`}>5</div>
          <div class="text-sm text-gray-500 mt-1">Anos de Garantia</div>
        </div>
        <div>
          <div class="text-2xl font-extrabold" style={`color: ${city.gradient};`}>{city.neighborhoods.length}+</div>
          <div class="text-sm text-gray-500 mt-1">Bairros Atendidos</div>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-6">
            Pintura de Alta Qualidade em {city.name}
          </h2>
          <div class="space-y-4 text-gray-600 leading-relaxed">
            <p>
              A Renovo Pinturas é referência em serviços de pintura residencial em {city.name} e região. Nossa equipe de profissionais experientes oferece um serviço completo, desde a preparação da superfície até o acabamento final.
            </p>
            <p>
              Utilizamos materiais de primeira qualidade e técnicas modernas de aplicação para garantir um resultado impecável. Atendemos diversos bairros de {city.name}, sempre com pontualidade, organização e respeito ao seu patrimônio.
            </p>
            <p>
              Solicite agora mesmo seu orçamento gratuito pelo WhatsApp. Nossa equipe vai até você para avaliar o trabalho e apresentar a melhor solução para sua casa ou empresa.
            </p>
          </div>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a
              href={ctaWhatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white font-semibold px-8 py-3 rounded-xl text-center transition-all hover:scale-105 flex items-center justify-center gap-2 text-sm"
              style={`background: linear-gradient(135deg, ${city.gradient}, ${city.gradientEnd});`}
            >
              Solicitar Orçamento
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>
            <a
              href="tel:+5511914044916"
              class="border-2 border-gray-200 text-gray-700 font-semibold px-8 py-3 rounded-xl text-center transition-all hover:border-gray-300 flex items-center justify-center gap-2 text-sm"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              Ligar Agora
            </a>
          </div>
        </div>
        <div class="relative">
          <img
            src="https://images.unsplash.com/photo-1562259929-b4e1fd3aef09?w=800&q=80"
            alt={`Pintura residencial em ${city.name}`}
            width="800"
            height="600"
            loading="lazy"
            class="rounded-2xl shadow-xl w-full object-cover"
            style="aspect-ratio: 4/3;"
          />
          <div
            class="absolute -bottom-6 -left-6 bg-white rounded-2xl shadow-lg p-4"
            style={`border-top: 4px solid ${city.gradient};`}
          >
            <div class="text-3xl font-extrabold" style={`color: ${city.gradient};`}>
              R$ {city.pricing.residencial}
            </div>
            <div class="text-gray-500 text-sm">por m²</div>
            <div class="text-gray-400 text-xs mt-1">Pintura Residencial</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
          Nossos Serviços em {city.name}
        </h2>
        <p class="text-gray-500 max-w-2xl mx-auto">
          Oferecemos soluções completas em pintura para residências e empresas em {city.name}. Tudo com garantia de 5 anos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {services.map((service) => (
          <div class="rounded-2xl p-8 border border-gray-100 hover:shadow-lg transition-shadow bg-white">
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center mb-6"
              style={`background: linear-gradient(135deg, ${service.color}, ${service.color}CC);`}
            >
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true" set:html={service.icon} />
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">{service.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed mb-4">{service.desc}</p>
            <div class="font-bold text-lg mb-4" style={`color: ${service.color};`}>{service.price}</div>
            <a
              href={ctaWhatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm font-semibold transition-colors hover:gap-2"
              style={`color: ${service.color};`}
            >
              Solicitar
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Neighborhoods -->
  <section id="bairros" class="section bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
          Bairros que Atendemos em {city.name}
        </h2>
        <p class="text-gray-500 max-w-2xl mx-auto">
          Atendemos todos os principais bairros de {city.name}. Solicite seu orçamento e verifique a disponibilidade na sua região.
        </p>
      </div>

      <div class="flex flex-wrap gap-3 justify-center mb-10">
        {city.neighborhoods.map((bairro) => (
          <a
            href={ctaWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm text-gray-700 hover:border-[#0E3A66] hover:text-[#0E3A66] transition-colors"
          >
            {bairro}
          </a>
        ))}
      </div>

      <div class="text-center">
        <a
          href={ctaWhatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-semibold px-8 py-3 rounded-xl text-white transition-all hover:scale-105"
          style={`background: linear-gradient(135deg, ${city.gradient}, ${city.gradientEnd});`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Solicitar Orçamento para Meu Bairro
        </a>
      </div>
    </div>
  </section>

  <!-- Nearby Cities -->
  {nearbyCities.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
            Cidades Próximas
          </h2>
          <p class="text-gray-500 max-w-2xl mx-auto">
            Também atendemos cidades próximas a {city.name}. Verifique a disponibilidade na sua região.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
          {nearbyCities.map((nc) => (
            <a
              href={`/pintura-residencial-${nc.slug}`}
              class="group p-4 rounded-xl border border-gray-200 hover:border-[#0E3A66] hover:shadow-md transition-all bg-gray-50 hover:bg-white text-center"
            >
              <div
                class="w-12 h-12 rounded-xl mx-auto mb-3 flex items-center justify-center text-white font-bold text-sm"
                style={`background: linear-gradient(135deg, ${nc.gradient}, ${nc.gradientEnd});`}
              >
                {nc.name.charAt(0)}
              </div>
              <div class="font-semibold text-sm text-gray-900 group-hover:text-[#0E3A66] transition-colors">
                {nc.name}
              </div>
              <div class="text-xs text-gray-400 mt-1">{nc.region}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Testimonials -->
  <section class="section" style={`background: linear-gradient(135deg, ${city.gradient} 0%, ${city.gradientEnd} 100%);`}>
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-white mb-4">
          Avaliações de Clientes em {city.name}
        </h2>
        <p class="text-white/70 max-w-2xl mx-auto">
          Veja o que nossos clientes de {city.name} dizem sobre o nosso trabalho.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {city.testimonials.map((t) => (
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
            <div class="flex gap-1 mb-3">
              {[1, 2, 3, 4, 5].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#F57C00" class="flex-shrink-0" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              ))}
            </div>
            <p class="text-white/90 text-sm leading-relaxed mb-4">"{t.text}"</p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white font-bold text-sm">
                {t.name.charAt(0)}
              </div>
              <div>
                <div class="text-white font-semibold text-sm">{t.name}</div>
                <div class="text-white/50 text-xs">{t.neighborhood}, {city.name}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-gray-50">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
            Perguntas Frequentes
          </h2>
        </div>

        <div class="space-y-3">
          {faqs.map((faq, i) => (
            <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-5 font-semibold text-gray-900 hover:bg-gray-50 transition-colors list-none">
                <span class="pr-4">{faq.q}</span>
                <svg
                  class="w-5 h-5 flex-shrink-0 text-gray-400 group-open:rotate-180 transition-transform"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </summary>
              <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-white">
    <div class="container">
      <div
        class="rounded-3xl shadow-xl p-8 md:p-12 text-center max-w-4xl mx-auto border border-gray-100 relative overflow-hidden"
        style={`border-top: 5px solid ${city.gradient};`}
      >
        <div class="absolute top-0 right-0 w-64 h-64 opacity-5" style={`background: radial-gradient(circle, ${city.gradient} 0%, transparent 70%);`} aria-hidden="true"></div>
        <div class="relative">
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
            Solicite seu Orçamento em {city.name}
          </h2>
          <p class="text-gray-500 max-w-2xl mx-auto mb-8">
            Entre em contato pelo WhatsApp e receba um orçamento personalizado para pintura em {city.name}. Sem compromisso e com resposta rápida.
          </p>
          <a
            href={ctaWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 text-white font-semibold px-10 py-4 rounded-xl text-lg transition-all hover:scale-105"
            style={`background: linear-gradient(135deg, ${city.gradient}, ${city.gradientEnd});`}
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Orçamento Grátis pelo WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
