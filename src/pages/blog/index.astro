---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { company } from '../../data/company';

const posts = [
  {
    slug: 'cores-para-pintura-residencial',
    title: 'Cores tendências para pintura residencial em 2024',
    excerpt: 'Descubra as cores que estão em alta para pintar sua casa este ano. Tons neutros, verdes naturais e azuis profundos dominam as tendências.',
    date: '15 Jan 2024',
    image: 'https://images.unsplash.com/photo-1562259929-b4e1fd3aef09?w=600&q=80',
    readTime: '5 min',
  },
  {
    slug: 'como-escolher-tinta-certa',
    title: 'Como escolher a tinta certa para cada ambiente',
    excerpt: 'Nem toda tinta serve para todo ambiente. Aprenda a escolher o tipo ideal de tinta para paredes internas, externas, tetos e áreas molhadas.',
    date: '28 Jan 2024',
    image: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=600&q=80',
    readTime: '4 min',
  },
  {
    slug: 'sinais-hora-repintar-casa',
    title: '5 sinais de que é hora de repintar sua casa',
    excerpt: 'Descascados, fissuras, desbotamento... Conheça os principais sinais de que suas paredes precisam de uma nova camada de pintura.',
    date: '10 Fev 2024',
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80',
    readTime: '3 min',
  },
  {
    slug: 'diferenca-pintura-interna-externa',
    title: 'Pintura interna vs externa: conheça as diferenças',
    excerpt: 'Você sabia que existem tintas específicas para áreas internas e externas? Entenda as diferenças e evite problemas futuros na sua obra.',
    date: '22 Fev 2024',
    image: 'https://images.unsplash.com/photo-1562259929-b4e1fd3aef09?w=600&q=80',
    readTime: '6 min',
  },
];
---

<BaseLayout
  title="Blog de Pintura e Reforma | Renovo Pinturas"
  description="Leia dicas, tendências e orientações sobre pintura residencial, comercial e impermeabilização. Blog da Renovo Pinturas em São Paulo."
  canonical="/blog"
>
  <section class="section bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">
          Blog de Pintura e Reforma
        </h1>
        <p class="text-gray-500 max-w-2xl mx-auto">
          Dicas, tendências e orientações para sua casa ou empresa. Conteúdo produzido pela equipe Renovo Pinturas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg transition-all">
            <div class="aspect-video overflow-hidden">
              <img
                src={post.image}
                alt={post.title}
                width="600"
                height="338"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 text-xs text-gray-400 mb-3">
                <span>{post.date}</span>
                <span>·</span>
                <span>{post.readTime} de leitura</span>
              </div>
              <h2 class="font-bold text-lg text-gray-900 mb-2 group-hover:text-[#0E3A66] transition-colors leading-snug">
                {post.title}
              </h2>
              <p class="text-gray-500 text-sm leading-relaxed">{post.excerpt}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12">
        <a
          href={`${company.whatsappUrl}?text=Olá! Vim pelo blog e gostaria de um orçamento.`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#0E3A66] hover:bg-[#1B5FB0] text-white font-semibold px-8 py-4 rounded-xl transition-all hover:scale-105"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Solicitar Orçamento Grátis
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
