---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/company';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  description: 'A Renovo Pinturas é uma empresa especializada em pintura residencial e comercial em São Paulo e região, com mais de 10 anos de experiência e garantia de 5 anos.',
  url: company.site,
  telephone: `+55 ${company.whatsapp}`,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: company.addressLocality,
    addressRegion: company.addressRegion,
    addressCountry: company.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.latitude,
    longitude: company.longitude,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '08:00',
    closes: '20:00',
  },
  priceRange: company.priceRange,
  areaServed: {
    '@type': 'State',
    name: 'São Paulo',
  },
  sameAs: [
    'https://www.instagram.com/renovopinturas',
    'https://www.facebook.com/renovopinturas',
  ],
};

const stats = [
  { value: '+10', label: 'Anos de Experiência' },
  { value: '+500', label: 'Clientes Atendidos' },
  { value: '35+', label: 'Cidades Atendidas' },
  { value: '5', label: 'Anos de Garantia' },
];

const values = [
  {
    title: 'Qualidade Garantida',
    description: 'Utilizamos apenas materiais de primeira linha e técnicas comprovadas, garantindo um acabamento impecável em cada projeto.',
    icon: `<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>`,
    gradient: '#0E3A66',
    gradientEnd: '#1B5FB0',
  },
  {
    title: 'Profissionais Experientes',
    description: 'Nossa equipe é formada por profissionais qualificados e em constante treinamento, prontos para atender qualquer desafio.',
    icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
    gradient: '#F57C00',
    gradientEnd: '#E65100',
  },
  {
    title: 'Transparência Total',
    description: 'Orçamento detalhado, sem surpresas. Informamos todos os custos antes de iniciar qualquer serviço.',
    icon: `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`,
    gradient: '#00695C',
    gradientEnd: '#00897B',
  },
  {
    title: 'Garantia de 5 Anos',
    description: 'Oferecemos garantia de 5 anos para todos os serviços, demostrando nossa confiança na qualidade do nosso trabalho.',
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
    gradient: '#7B1FA2',
    gradientEnd: '#9C27B0',
  },
];

const team = [
  {
    role: 'Equipe de Pintura',
    description: 'Pintores profissionais com anos de experiência em pintura residencial e comercial, especializados em acabamentos de alta qualidade.',
    features: ['Técnicas modernas de aplicação', 'Preparação profissional de superfícies', 'Pintura de tetos, paredes e esquadrias'],
  },
  {
    role: 'Equipe de Impermeabilização',
    description: 'Técnicos especializados em impermeabilização, com conhecimento profundo de produtos e técnicas para cada tipo de superfície.',
    features: ['Diagnóstico preciso de infiltrações', 'Produtos de última geração', 'Soluções duradouras e garantidas'],
  },
  {
    role: 'Equipe de Pedreiro',
    description: 'Profissionais de alvenaria e reboco com experiência em obras de todos os portes, desde pequenos reparos até reformas completas.',
    features: ['Reboco e massa corrida', 'Contrapiso e Alicerces', 'Alvenaria e reparos estruturais'],
  },
];
---

<BaseLayout
  title="Sobre a Renovo Pinturas | Pintura Profissional em São Paulo"
  description="Conheça a Renovo Pinturas: mais de 10 anos de experiência, 500+ clientes atendidos, 35+ cidades na Grande São Paulo. Garantia de 5 anos em todos os serviços."
  canonical="/sobre"
  breadcrumbItems={[
    { name: 'Sobre', href: '/sobre' },
  ]}
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #0E3A66 0%, #1B5FB0 100%);">
    <div class="absolute inset-0 opacity-10 overflow-hidden">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
            <path d="M 10 0 L 0 0 0 10" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100" height="100" fill="url(#grid)"/>
      </svg>
    </div>
    <div class="container py-16 md:py-20 relative">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-white/10 text-white text-xs font-semibold px-4 py-1.5 rounded-full mb-4">
          Desde 2014
        </span>
        <h1 class="text-white font-extrabold text-3xl md:text-4xl lg:text-5xl mb-4 leading-tight">
          Sobre a Renovo Pinturas
        </h1>
        <p class="text-white/80 text-base md:text-lg mb-8 max-w-2xl leading-relaxed">
          Há mais de 10 anos entregando pinturas de alta qualidade em São Paulo e região. Nossa missão é transformar ambientes com profissionalismo, qualidade e preço justo.
        </p>
        <a
          href={`${company.whatsappUrl}?text=Olá! Vim pela página Sobre e gostaria de um orçamento.`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#25D366] hover:bg-[#20BA5C] text-white font-semibold px-8 py-4 rounded-xl text-center transition-all hover:scale-105 inline-flex items-center gap-3"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Solicitar Orçamento Grátis
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-white border-b border-gray-200">
    <div class="container py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {stats.map((stat) => (
          <div>
            <div class="text-2xl md:text-3xl font-extrabold text-[#0E3A66]">{stat.value}</div>
            <div class="text-sm text-gray-500 mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About Content -->
  <section class="section bg-gray-50">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
            Quem Somos
          </h2>
          <p class="text-gray-500 leading-relaxed">
            A Renovo Pinturas nasceu com o objetivo de oferecer serviços de pintura e reforma com qualidade excepcional e preços justos. Atuamos há mais de uma década na Grande São Paulo, ABCD e demais regiões, conquistando a confiança de centenas de clientes.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-8 md:p-10 border border-gray-100 shadow-sm mb-8">
          <div class="prose prose-gray max-w-none">
            <p class="text-gray-600 leading-relaxed mb-4">
              Somos especializados em <strong>pintura residencial</strong> e <strong>comercial</strong>, oferecendo soluções completas que incluem preparação de superfícies, reboco, massa corrida, textura, impermeabilização e serviços de pedreiro.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Nossa experiência de mais de 10 anos nos permitiu atender mais de <strong>500 clientes</strong> espalhados por <strong>35 cidades</strong> da Grande São Paulo, incluindo a capital, ABCD, Zona Norte, Oeste, Sul e Leste.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Trabalhamos com <strong>materiais de primeira qualidade</strong> e oferecemos <strong>garantia de 5 anos</strong> em todos os nossos serviços. Nossa equipe é formada por profissionais experientes e comprometidos com a excelência em cada detalhe.
            </p>
            <p class="text-gray-600 leading-relaxed">
              O <strong>orçamento é sempre gratuito</strong> e sem compromisso. Nossa equipe vai até o local para avaliar, tirar medidas precisas e apresentar uma proposta detalhada e transparente.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section bg-white">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
          Por Que Escolher a Renovo Pinturas?
        </h2>
        <p class="text-gray-500 max-w-2xl mx-auto">
          Nossos valores guiam cada projeto que assumimos, garantindo satisfação total dos nossos clientes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {values.map((value) => (
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4">
              <div
                class="w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center"
                style={`background: linear-gradient(135deg, ${value.gradient}, ${value.gradientEnd});`}
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true" set:html={value.icon} />
              </div>
              <div>
                <h3 class="font-bold text-gray-900 mb-2">{value.title}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{value.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
          Nossas Equipes
        </h2>
        <p class="text-gray-500 max-w-2xl mx-auto">
          Contamos com equipes especializadas e em constante capacitação para oferecer o melhor serviço em cada área.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {team.map((item, index) => {
          const gradients = [
            { gradient: '#0E3A66', gradientEnd: '#1B5FB0' },
            { gradient: '#F57C00', gradientEnd: '#E65100' },
            { gradient: '#00695C', gradientEnd: '#00897B' },
          ];
          const g = gradients[index];
          return (
            <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
              <div class="p-6" style={`border-bottom: 1px solid ${g.gradient}20;`}>
                <div
                  class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
                  style={`background: linear-gradient(135deg, ${g.gradient}, ${g.gradientEnd});`}
                >
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">{item.role}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{item.description}</p>
              </div>
              <div class="p-6">
                <ul class="space-y-2">
                  {item.features.map((f) => (
                    <li class="flex items-center gap-2 text-sm text-gray-600">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0" style={`color: ${g.gradient};`} aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-white">
    <div class="container">
      <div class="bg-gray-50 rounded-3xl p-8 md:p-12 text-center max-w-3xl mx-auto border border-gray-200">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4">
          Solicite seu Orçamento Gratuito
        </h2>
        <p class="text-gray-500 mb-8 max-w-xl mx-auto">
          Entre em contato pelo WhatsApp e receba um orçamento personalizado. Atendimento rápido, preço justo e trabalho garantido.
        </p>
        <a
          href={`${company.whatsappUrl}?text=Olá! Vim pela página Sobre e gostaria de um orçamento.`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-[#0E3A66] hover:bg-[#1B5FB0] text-white font-semibold px-10 py-4 rounded-xl text-lg transition-all hover:scale-105"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Falar pelo WhatsApp
        </a>
        <p class="text-gray-400 text-xs mt-6">
          Atendimento de segunda a sábado, das 8h às 20h. Orçamento sem compromisso.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
